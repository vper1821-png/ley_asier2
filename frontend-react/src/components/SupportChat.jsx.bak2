import { useState, useRef, useEffect, useCallback } from 'react';
import { useLocation, useNavigate } from 'react-router-dom';
import { useAuth } from '../context/AuthContext';
import * as api from '../api/api';

const QUICK_ACTIONS = [
  { label: '📋 Ley 21.719', query: '¿Qué es la Ley 21.719?' },
  { label: '🔒 Datos personales', query: '¿Qué son los datos personales?' },
  { label: '⚠️ Reportar brecha', query: '¿Cómo reportar una brecha de seguridad?' },
  { label: '💻 Conectar BD', query: '¿Cómo conectar mi base de datos?' },
  { label: '📊 Servicios', query: '¿Qué servicios ofrece esta plataforma?' },
  { label: '🛡️ Sanciones', query: '¿Cuáles son las sanciones por incumplir la ley?' },
];

const WELCOME_MSG = {
  role: 'bot',
  text: '¡Hola! Soy el **Asistente Virtual de Invisia/SecureLab** 🤖\n\nEstoy aquí para ayudarte con:\n- 🔒 **Ley 21.719** de Protección de Datos Personales de Chile\n- 📋 **Cumplimiento normativo** y derechos ARCO\n- 💻 **Uso de la plataforma** (escaneos, BD, agentes)\n- ⚠️ **Brechas de seguridad** y notificaciones\n- 🛡️ **Sanciones, DPD, APDP** y más\n\n**Importante:** Solo puedo ayudarte con temas relacionados a la Ley 21.719, protección de datos en Chile, y los servicios de esta plataforma.\n\n¿En qué puedo ayudarte hoy?',
  quick_actions: QUICK_ACTIONS,
};

const OUT_OF_SCOPE_MSG = 'Lo siento, solo puedo ayudarte con temas relacionados a la **Ley 21.719 de Protección de Datos Personales de Chile** y los **servicios de la plataforma Invisia/SecureLab** (escaneo de seguridad, gestión de bases de datos, cumplimiento normativo, agentes, etc.).\n\nSi tu consulta es sobre otro tema, no puedo asistirte. ¿Hay algo relacionado con la ley chilena de datos o la plataforma en lo que pueda ayudarte?';

function simpleMarkdown(text) {
  if (!text) return '';
  let html = text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
  html = html.replace(/\*\*(.+?)\*\*/g, '<strong class="text-text-heading">$1</strong>');
  html = html.replace(/\*(.+?)\*/g, '<em>$1</em>');
  html = html.replace(/`([^`]+)`/g, '<code class="bg-bg-base px-1 py-0.5 rounded text-[10px] text-indigo-300">$1</code>');
  html = html.replace(/^### (.+)$/gm, '<h4 class="text-[12px] font-semibold text-white mt-2 mb-1">$1</h4>');
  html = html.replace(/^## (.+)$/gm, '<h4 class="text-[12px] font-semibold text-white mt-2 mb-1">$1</h4>');
  html = html.replace(/^# (.+)$/gm, '<h4 class="text-[12px] font-semibold text-white mt-2 mb-1">$1</h4>');
  html = html.replace(/^\- (.+)$/gm, '<div class="flex gap-1.5"><span class="text-indigo-400">•</span><span>$1</span></div>');
  html = html.replace(/^\d+\.\s(.+)$/gm, '<div class="flex gap-1.5"><span class="text-indigo-400 min-w-[16px]">•</span><span>$1</span></div>');
  html = html.replace(/\n\n/g, '<br/><br/>');
  html = html.replace(/\n/g, '<br/>');
  return html;
}

function getPageContext(pathname) {
  if (!pathname || pathname === '/') return { page: 'landing', description: 'Página de inicio (Landing)' };
  if (pathname.startsWith('/dashboard')) return { page: 'dashboard', description: 'Panel principal (Dashboard)' };
  if (pathname.startsWith('/compliance')) return { page: 'compliance', description: 'Gestión de Cumplimiento Normativo' };
  if (pathname.startsWith('/admin')) return { page: 'admin', description: 'Panel de Administración' };
  if (pathname.startsWith('/dpo')) return { page: 'dpo', description: 'Dashboard del Delegado de Protección de Datos' };
  if (pathname.startsWith('/pending')) return { page: 'pending', description: 'Cuenta pendiente de activación' };
  if (pathname.startsWith('/arco')) return { page: 'arco', description: 'Formulario de solicitud ARCO' };
  if (pathname.startsWith('/privacy')) return { page: 'privacy', description: 'Política de Privacidad' };
  if (pathname.startsWith('/track')) return { page: 'citizen', description: 'Portal Ciudadano' };
  return { page: 'other', description: 'Otra sección de la plataforma' };
}

export default function SupportChat() {
  const { token } = useAuth();
  const location = useLocation();
  const navigate = useNavigate();
  const [open, setOpen] = useState(false);
  const [messages, setMessages] = useState([]);
  const [input, setInput] = useState('');
  const [unread, setUnread] = useState(0);
  const [spinning, setSpinning] = useState(false);
  const [loading, setLoading] = useState(false);
  const [pos, setPos] = useState(() => ({ x: window.innerWidth - 80, y: window.innerHeight - 80 }));
  const bottomRef = useRef(null);
  const inputRef = useRef(null);
  const btnRef = useRef(null);
  const chatRef = useRef(null);
  const dragRef = useRef({ dragging: false, startX: 0, startY: 0, startPosX: 0, startPosY: 0 });
  const wasDragged = useRef(false);
  const rafRef = useRef(null);

  useEffect(() => {
    const handleResize = () => {
      setPos(p => ({ x: Math.min(p.x, window.innerWidth - 80), y: Math.min(p.y, window.innerHeight - 80) }));
    };
    window.addEventListener('resize', handleResize);
    return () => window.removeEventListener('resize', handleResize);
  }, []);

  useEffect(() => {
    if (open) bottomRef.current?.scrollIntoView({ behavior: 'smooth' });
  }, [messages, open, loading]);

  useEffect(() => {
    if (open && messages.length === 0) setMessages([WELCOME_MSG]);
  }, [open]);

  const clamp = (x, y) => ({
    x: Math.max(0, Math.min(window.innerWidth - 56, x)),
    y: Math.max(0, Math.min(window.innerHeight - 56, y)),
  });

  const updatePos = (clientX, clientY) => {
    const rawX = dragRef.current.startPosX + (clientX - dragRef.current.startX);
    const rawY = dragRef.current.startPosY + (clientY - dragRef.current.startY);
    const clamped = clamp(rawX, rawY);
    if (btnRef.current) {
      btnRef.current.style.left = clamped.x + 'px';
      btnRef.current.style.top = clamped.y + 'px';
    }
  };

  const commitPos = () => {
    if (btnRef.current) {
      const left = parseFloat(btnRef.current.style.left);
      const top = parseFloat(btnRef.current.style.top);
      if (!isNaN(left) && !isNaN(top)) setPos({ x: left, y: top });
    }
  };

  const handleMouseDown = (e) => {
    wasDragged.current = false;
    dragRef.current.dragging = true;
    dragRef.current.startX = e.clientX;
    dragRef.current.startY = e.clientY;
    dragRef.current.startPosX = pos.x;
    dragRef.current.startPosY = pos.y;
    document.addEventListener('mousemove', handleMouseMove);
    document.addEventListener('mouseup', handleMouseUp);
  };

  const handleTouchStart = (e) => {
    wasDragged.current = false;
    const t = e.touches[0];
    dragRef.current.dragging = true;
    dragRef.current.startX = t.clientX;
    dragRef.current.startY = t.clientY;
    dragRef.current.startPosX = pos.x;
    dragRef.current.startPosY = pos.y;
    document.addEventListener('touchmove', handleTouchMove, { passive: true });
    document.addEventListener('touchend', handleTouchEnd);
  };

  const handleMouseMove = (e) => {
    if (!dragRef.current.dragging) return;
    wasDragged.current = true;
    if (rafRef.current) return;
    rafRef.current = requestAnimationFrame(() => {
      updatePos(e.clientX, e.clientY);
      rafRef.current = null;
    });
  };

  const handleTouchMove = (e) => {
    if (!dragRef.current.dragging) return;
    wasDragged.current = true;
    const t = e.touches[0];
    if (rafRef.current) return;
    rafRef.current = requestAnimationFrame(() => {
      updatePos(t.clientX, t.clientY);
      rafRef.current = null;
    });
  };

  const handleMouseUp = () => {
    dragRef.current.dragging = false;
    if (rafRef.current) { cancelAnimationFrame(rafRef.current); rafRef.current = null; }
    commitPos();
    document.removeEventListener('mousemove', handleMouseMove);
    document.removeEventListener('mouseup', handleMouseUp);
  };

  const handleTouchEnd = () => {
    dragRef.current.dragging = false;
    if (rafRef.current) { cancelAnimationFrame(rafRef.current); rafRef.current = null; }
    commitPos();
    document.removeEventListener('touchmove', handleTouchMove);
    document.removeEventListener('touchend', handleTouchEnd);
  };

  const handleToggle = () => {
    if (wasDragged.current) { wasDragged.current = false; return; }
    if (!open) {
      setSpinning(true);
      setUnread(0);
      setTimeout(() => {
        setSpinning(false);
        setOpen(true);
        setTimeout(() => inputRef.current?.focus(), 200);
      }, 280);
    } else {
      setOpen(false);
    }
  };

  const executePageAction = useCallback((action) => {
    if (!action) return;
    switch (action.action || action.type) {
      case 'navigate':
        navigate(action.value);
        break;
      case 'click_nav':
        window.dispatchEvent(new CustomEvent('chat-nav-click', { detail: { nav: action.value } }));
        break;
      case 'scroll_to':
        try {
          const el = document.querySelector(action.value);
          if (el) el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } catch {}
        break;
      case 'focus_form':
        try {
          const form = document.getElementById(action.value) || document.querySelector(`[data-form="${action.value}"]`);
          if (form) {
            form.scrollIntoView({ behavior: 'smooth', block: 'center' });
            const firstInput = form.querySelector('input, textarea, select');
            if (firstInput) setTimeout(() => firstInput.focus(), 500);
          }
        } catch {}
        break;
      case 'show_phone':
        setMessages(prev => [...prev, { role: 'bot', text: `📞 **Teléfono de soporte:** ${action.value}\n🕐 **Horario:** ${action.details?.split('Horario: ')[1] || 'Lunes a viernes 9:00-18:00'}` }]);
        break;
      case 'show_email':
        setMessages(prev => [...prev, { role: 'bot', text: `📧 **Email:** ${action.value}\n${action.details || ''}` }]);
        break;
      case 'create_consent':
        navigate('/compliance/consents/new');
        break;
      case 'report_breach':
        navigate('/compliance/breaches/new');
        break;
      case 'scan_domain':
        navigate('/scan?domain=' + encodeURIComponent(action.params?.domain || ''));
        break;
      case 'scan_database':
        navigate('/databases');
        break;
      case 'connect_database':
        navigate('/databases/new');
        break;
      case 'generate_report':
        navigate('/reports');
        break;
      case 'open_ticket':
        navigate('/support/tickets/new');
        break;
      case 'enable_2fa':
        navigate('/settings/security');
        break;
      default:
        break;
    }
  }, [navigate]);

  const handleQuickAction = useCallback((qa) => {
    if (qa.query) {
      setInput(qa.query);
      setTimeout(() => handleSend(qa.query), 100);
    } else if (qa.action || qa.type) {
      executePageAction(qa);
    }
  }, [token, location.pathname]);

  const handleSend = useCallback(async (overrideText) => {
    const text = (overrideText || input).trim();
    if (!text || loading) return;
    if (!overrideText) setInput('');
    const userMsg = { role: 'user', text };
    setMessages(prev => [...prev, userMsg]);
    setLoading(true);
    const pageCtx = getPageContext(location.pathname);
    try {
      const result = await api.assistantAsk(text, token, null, JSON.stringify(pageCtx));
      if (result && result.answer) {
        const botMsg = {
          role: 'bot',
          text: result.answer,
          confidence: result.confidence,
          category: result.category,
          source: result.source,
          quick_actions: result.quick_actions || null,
          page_actions: result.page_actions || null,
          pending_action: result.pending_action || null,
        };
        if (result.source === 'out_of_scope') {
          botMsg.text = OUT_OF_SCOPE_MSG;
          botMsg.quick_actions = QUICK_ACTIONS;
          botMsg.page_actions = null;
        }
        setMessages(prev => [...prev, botMsg]);
      } else if (result && result.error) {
        setMessages(prev => [...prev, { role: 'bot', text: `⚠️ ${result.error}. Intenta de nuevo o contacta a soporte.`, quick_actions: QUICK_ACTIONS }]);
      } else {
        setMessages(prev => [...prev, { role: 'bot', text: 'Lo siento, no pude procesar tu consulta. ¿Puedes reformularla?', quick_actions: QUICK_ACTIONS }]);
      }
    } catch (err) {
      setMessages(prev => [...prev, { role: 'bot', text: '⚠️ Error de conexión con el asistente. Verifica tu conexión e inténtalo de nuevo.', quick_actions: QUICK_ACTIONS }]);
    } finally {
      setLoading(false);
    }
  }, [input, loading, token, location.pathname]);

  const handleFeedback = useCallback(async (msgIdx, helpful) => {
    const msg = messages[msgIdx];
    if (!msg || msg.role !== 'bot') return;
    const updated = [...messages];
    updated[msgIdx] = { ...msg, feedback: helpful };
    setMessages(updated);
    try { await api.assistantFeedback(msg.text, helpful, token); } catch {}
  }, [messages, token]);

  const handleKeyDown = (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      handleSend();
    }
  };

  const chatStyle = (() => {
    const bx = pos.x, by = pos.y;
    const gap = 8;
    const cw = 380, ch = 520;
    const placeBelow = by + 56 + gap + ch <= window.innerHeight;
    const placeRight = bx + cw <= window.innerWidth;
    const top = placeBelow ? by + 56 + gap : Math.max(0, by - ch - gap);
    const left = placeRight ? bx : Math.max(0, bx + 56 - cw);
    return { top: Math.min(top, window.innerHeight - ch - gap), left: Math.min(left, window.innerWidth - cw - gap) };
  })();

  const BotAvatar = () => (
    <div className="w-7 h-7 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center shadow-md shadow-indigo-500/20 flex-shrink-0">
      <svg className="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
    </div>
  );

  const UserAvatar = () => (
    <div className="w-7 h-7 rounded-full bg-bg-elevated border border-border-theme flex items-center justify-center flex-shrink-0">
      <svg className="w-3.5 h-3.5 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
    </div>
  );

  return (
    <>
      {open && (
        <div ref={chatRef} className="fixed z-[200] w-[400px] h-[580px] rounded-3xl shadow-2xl shadow-black/50 flex flex-col overflow-hidden animate-chat-open border border-white/[0.06]"
          style={{ ...chatStyle, background: 'linear-gradient(145deg, rgba(20,20,28,0.95) 0%, rgba(12,12,18,0.98) 100%)', backdropFilter: 'blur(20px)' }}>
          {/* ambient glow */}
          <div className="absolute -top-20 -right-20 w-40 h-40 bg-indigo-500/20 rounded-full blur-3xl pointer-events-none" />
          <div className="absolute -bottom-20 -left-20 w-40 h-40 bg-purple-500/10 rounded-full blur-3xl pointer-events-none" />

          <div className="relative flex items-center justify-between px-5 py-4 border-b border-white/[0.06] flex-shrink-0 bg-white/[0.03]">
            <div className="flex items-center gap-3">
              <div className="relative">
                <div className="w-9 h-9 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white shadow-lg shadow-indigo-500/25">
                  <svg className="w-[18px] h-[18px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
                </div>
                <span className="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 rounded-full bg-green-400 border-2 border-[#14141c] animate-pulse" />
              </div>
              <div>
                <p className="text-[13px] font-semibold text-white tracking-tight">Asistente Invisia</p>
                <p className="text-[10px] text-text-muted">IA especializada • Ley 21.719 Chile</p>
              </div>
            </div>
            <div className="flex items-center gap-1">
              <button onClick={() => { setMessages([WELCOME_MSG]); }} className="p-2 rounded-lg text-text-muted hover:text-white hover:bg-white/[0.06] transition-colors" title="Nueva conversación">
                <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 4v16m8-8H4"/></svg>
              </button>
              <button onClick={() => setOpen(false)} className="p-2 rounded-lg text-text-muted hover:text-white hover:bg-white/[0.06] transition-colors">
                <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12"/></svg>
              </button>
            </div>
          </div>

          <div className="flex-1 overflow-y-auto p-5 space-y-4 chat-scroll relative">
            {messages.map((m, i) => (
              <div key={i} className={`flex flex-col ${m.role === 'user' ? 'items-end' : 'items-start'}`}>
                <div className={`flex items-end gap-2.5 ${m.role === 'user' ? 'flex-row-reverse' : 'flex-row'}`}>
                  {m.role === 'bot' ? <BotAvatar /> : <UserAvatar />}
                  <div className={`max-w-[80%] px-4 py-3 text-[12px] leading-relaxed shadow-sm ${
                    m.role === 'user'
                      ? 'bg-gradient-to-br from-indigo-500/90 to-purple-600/90 text-white rounded-2xl rounded-br-md'
                      : 'bg-white/[0.04] border border-white/[0.06] text-gray-100 rounded-2xl rounded-bl-md'
                  }`}>
                    {m.role === 'bot' ? (
                      <div className="assistant-msg" dangerouslySetInnerHTML={{ __html: simpleMarkdown(m.text) }} />
                    ) : m.text}
                  </div>
                </div>

                {m.role === 'bot' && m.page_actions && i === messages.length - 1 && !loading && (
                  <div className="flex flex-wrap gap-2 mt-2.5 ml-9">
                    {m.page_actions.map((pa, pi) => (
                      <button key={pi} onClick={() => executePageAction(pa)}
                        className="text-[10px] px-3 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-500/30 text-indigo-300 hover:bg-indigo-500/20 hover:text-white hover:border-indigo-400/40 transition-all">
                        {pa.label}
                      </button>
                    ))}
                  </div>
                )}

                {m.role === 'bot' && m.pending_action && i === messages.length - 1 && !loading && (
                  <div className="mt-2.5 ml-9 p-3 rounded-2xl bg-gradient-to-r from-amber-500/10 to-orange-500/10 border border-amber-500/20 shadow-sm">
                    <p className="text-[11px] text-amber-100/90 mb-2.5">{m.pending_action.message}</p>
                    <div className="flex gap-2">
                      <button onClick={() => executePageAction({ ...m.pending_action, action: m.pending_action.action })}
                        className="text-[11px] px-3.5 py-1.5 rounded-xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 hover:bg-emerald-500/25 hover:text-white transition-all">
                        {m.pending_action.confirm_label || 'Sí, ejecutar'}
                      </button>
                      <button onClick={() => setMessages(prev => prev.map((msg, idx) => idx === i ? { ...msg, pending_action: null } : msg))}
                        className="text-[11px] px-3.5 py-1.5 rounded-xl bg-white/[0.04] border border-white/[0.08] text-text-muted hover:text-white hover:border-red-400/30 hover:bg-red-500/10 transition-all">
                        {m.pending_action.reject_label || 'No, gracias'}
                      </button>
                    </div>
                  </div>
                )}

                {m.role === 'bot' && m.quick_actions && !m.page_actions && i === messages.length - 1 && !loading && (
                  <div className="flex flex-wrap gap-2 mt-2.5 ml-9">
                    {m.quick_actions.map((qa, qi) => (
                      <button key={qi} onClick={() => handleQuickAction(qa)}
                        className="text-[10px] px-3 py-1.5 rounded-full bg-white/[0.04] border border-white/[0.08] text-text-muted hover:text-white hover:border-indigo-400/40 hover:bg-indigo-500/10 transition-all">
                        {qa.label}
                      </button>
                    ))}
                  </div>
                )}

                {m.role === 'bot' && m.source && i === messages.length - 1 && !loading && (
                  <div className="flex items-center gap-2 mt-1.5 ml-9">
                    <button onClick={() => handleFeedback(i, true)} className={`p-1.5 rounded-lg transition-colors ${m.feedback === true ? 'text-green-400 bg-green-500/10' : 'text-text-subtle hover:text-green-400 hover:bg-white/[0.04]'}`} title="Útil">
                      <svg className="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5"/></svg>
                    </button>
                    <button onClick={() => handleFeedback(i, false)} className={`p-1.5 rounded-lg transition-colors ${m.feedback === false ? 'text-red-400 bg-red-500/10' : 'text-text-subtle hover:text-red-400 hover:bg-white/[0.04]'}`} title="No útil">
                      <svg className="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M10 14H5.236a2 2 0 01-1.789-2.894l3.5-7A2 2 0 018.736 3h4.018a2 2 0 01.485.06l3.76.94m-7 10v5a2 2 0 002 2h.096c.5 0 .905-.405.905-.904 0-.715.211-1.413.608-2.008L17 13V4m-7 10h2m5-10h2a2 2 0 012 2v6a2 2 0 01-2 2h-2.5"/></svg>
                    </button>
                    {m.confidence !== undefined && (
                      <span className="text-[10px] text-text-subtle ml-1">
                        {m.source === 'ollama' ? '🤖 IA' : m.source === 'matched' ? '📚 BD conocimiento' : '💡 General'}
                      </span>
                    )}
                  </div>
                )}
              </div>
            ))}

            {loading && (
              <div className="flex items-end gap-2.5">
                <BotAvatar />
                <div className="bg-white/[0.04] border border-white/[0.06] rounded-2xl rounded-bl-md px-4 py-3">
                  <div className="flex gap-1.5">
                    <span className="w-2 h-2 rounded-full bg-indigo-400 animate-bounce" style={{ animationDelay: '0ms' }}></span>
                    <span className="w-2 h-2 rounded-full bg-indigo-400 animate-bounce" style={{ animationDelay: '150ms' }}></span>
                    <span className="w-2 h-2 rounded-full bg-indigo-400 animate-bounce" style={{ animationDelay: '300ms' }}></span>
                  </div>
                </div>
              </div>
            )}
            <div ref={bottomRef} />
          </div>

          <div className="relative px-4 py-3 border-t border-white/[0.06] flex-shrink-0 bg-white/[0.02]">
            <div className="flex gap-2 items-end p-1.5 rounded-2xl bg-bg-base/80 border border-white/[0.06] focus-within:border-indigo-500/40 transition-colors">
              <input ref={inputRef} value={input} onChange={e => setInput(e.target.value)}
                onKeyDown={handleKeyDown} placeholder="Pregunta sobre la Ley 21.719 o la plataforma..."
                disabled={loading}
                className="flex-1 bg-transparent border-0 text-[12px] text-white px-3 py-2.5 focus:outline-none focus:ring-0 placeholder-text-subtle disabled:opacity-50" />
              <button onClick={() => handleSend()} disabled={loading || !input.trim()}
                className="p-2.5 rounded-xl text-white bg-gradient-to-br from-indigo-500 to-purple-600 hover:from-indigo-400 hover:to-purple-500 disabled:opacity-40 disabled:cursor-not-allowed transition-all flex-shrink-0 shadow-lg shadow-indigo-500/20">
                <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
              </button>
            </div>
            <p className="text-[9px] text-text-subtle text-center mt-2">
              El asistente solo responde temas de Ley 21.719 y servicios de la plataforma
            </p>
          </div>
        </div>
      )}

      <button ref={btnRef} onMouseDown={handleMouseDown} onTouchStart={handleTouchStart} onClick={handleToggle}
        className={`fixed z-[200] w-14 h-14 rounded-full flex items-center justify-center transition-all duration-200 hover:scale-110 hover:shadow-indigo-500/40 select-none ${open ? 'opacity-0 pointer-events-none' : ''} ${spinning ? 'animate-spin-260' : ''}`}
        style={{ left: pos.x, top: pos.y }}>
        <div className="w-14 h-14 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 p-0.5 shadow-xl shadow-indigo-500/30">
          <img src="/chatbot.png" alt="Chat" className="w-full h-full rounded-full object-cover border-2 border-bg-base" />
        </div>
        {!open && unread > 0 && (
          <div className="absolute -top-1 -right-1 w-5 h-5 rounded-full bg-red-500 text-white text-[9px] font-bold flex items-center justify-center shadow-lg pointer-events-none border-2 border-bg-base">
            {unread}
          </div>
        )}
      </button>
    </>
  );
}
